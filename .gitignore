# Qt build artifacts
*.pro.user
*.pro.user.*
*.qmlproject.user
*.qmlproject.user.*
Makefile
Makefile.*
.qmake.stash
.qmake.cache

# Build output directories
build/
Build/
# Install image staged by scripts/make_dist.ps1 — build output, not source.
dist/
debug/
release/
Debug/
Release/
.agent/
.claude/
.codex/
.github/
.vscode/
.qtc_clangd/

# Compiled object files
*.o
*.obj

# Compiled binaries
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.idb
*.ipdb
*.iobj

# Qt MOC / UIC / RCC generated files
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h

# Qt Creator project backup
*.pro.orig
*.pri.orig

# Qt linguist
*.qm

# Visual Studio / MSVC
.vs/
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
*.suo
*.opensdf
*.sdf
*.aps

# CMake (if used alongside qmake)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt

# CLion / JetBrains
.idea/
cmake-build-*/

# Claude Code memory (local AI assistant data)
.claude/*
# but track shared agent skills (Qt AI Skills)
!.claude/skills/

# OS specific
.DS_Store
Thumbs.db
desktop.ini

# Editor artifacts
*.swp
*.swo
*~
.vscode/settings.json

# OpenCV / third-party compiled binaries (keep sources)
*.a
*.so
*.so.*
*.dylib

# Project-specific: keep build configs that are checked in separately
!3rdparty/**

# Prebuilt third-party install trees are provisioned locally, NOT tracked
# (see 3rdparty/README.md). Vendored source that IS tracked: advance_docking,
# qtpropertybrowser (re-included by !3rdparty/** above).
3rdparty/assimp/
3rdparty/boost/
3rdparty/coal/
3rdparty/eigen/
3rdparty/fcl/
3rdparty/libccd/

# Machine-local dependency paths read by qmake. Absolute paths that are true for one
# workstation only; qmake/local_paths.pri.example IS tracked and is the template.
qmake/local_paths.pri

# Local Codex config for this machine only
.codex/

# Local agent tooling clones/configs (not part of the build)
.agent/
.agents/

# Test run outputs
tests/**/*_results.txt

# Qt Designer autosave buffers. Written next to the .ui whenever Designer has unsaved
# changes; they are editor state, not source, and committing one would let a stale buffer
# look like a reviewed change.
*.ui.autosave
