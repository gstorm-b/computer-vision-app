}

package "Camera" {
  enum CameraType {
    CamType
    Realsense
    BaslerGigE
    BaslerUSB
    JaiGigE
    VirtualCamera
  }

  abstract class CameraCfg {
    +cameraType() : CameraType
    +calibrator() : calib::Calibrator
    +toJson() : QJsonObject
    +fromJson(obj) : bool
  }

  abstract class CameraDevice <<QObject>> {
    +cameraType() : CameraType
    +hasIOPort() : bool
    +isRgbCamera() : bool
    +grabSingleShot() : GrabResult
    +softwareTriggerShot() : GrabResult
    +startContinuousShot() : bool
    +stopContinuousShot() : void
    +isContinuousActive() : bool
    +setBacklightOverride(on) : bool
    +isBacklightOverridden() : bool
    -- signals --
    +continuousFrameReady(result)
    +continuousStateChanged(active)
    +backlightStateChanged(on)
  }
  note right of CameraDevice
    continuousStateChanged and backlightStateChanged are
    NOT edge signals. The device reports after EVERY
    request, including ones that changed nothing, because
    CameraRunner resolves its commands from them.
  end note

  class BaslerGigeCfg <<Q_GADGET>> {
    +cameraType() : BaslerGigE
    +toJson() : QJsonObject
    +fromJson(obj) : bool
    +clone() : IDeviceCfg*
  }

  class BaslerGigECamera <<QObject>> {
    +cameraType() : BaslerGigE
    +deviceConnect() : bool
    +deviceDisconnect() : bool
    +setDeviceConfig(cfg) : void
    +grabSingleShot() : GrabResult
    +softwareTriggerShot() : GrabResult
  }

  class JaiGigeCfg <<Q_GADGET>> {
    +cameraType() : JaiGigE
    +toJson() : QJsonObject
    +fromJson(obj) : bool
    +clone() : IDeviceCfg*
    -- backlight --
    +autoBacklightControl : bool
    +autoBacklightLine : QString
    +autoBacklightInvert : bool
    +autoBacklightDelay : int
  }

  class JaiGigECamera <<QObject>> {
    +cameraType() : JaiGigE
    +deviceConnect() : bool
    +deviceDisconnect() : bool
    +grabSingleShot() : GrabResult
    -- continuous (live view) --
    +startContinuousShot() : bool
    +stopContinuousShot() : void
    -pumpContinuousFrame() : void
    -- backlight --
    +setBacklightOverride(on) : bool
    -setAutoBacklightState(on) : bool
    -setBacklightState(on) : void
    -configureBacklightOutput() : void
    -- diagnostics --
    +streamDiagnostics() : QString
    +backlightDiagnostics() : QString
  }
  note bottom of JaiGigECamera
    Pleora eBUS SDK. Two traps encoded here:
    (1) pumpContinuousFrame() RE-POSTS itself queued,
        one frame per event-loop trip. A while-loop
        starves the device thread and stop never arrives.
    (2) Every automatic backlight write goes through the
        single funnel setAutoBacklightState(), so a manual
        override cannot be forgotten by a new grab path.
  end note

  class JaiGenICamRuntime <<free function>> {
    +ensureGenICamRuntime(detail) : bool
  }
  note right of JaiGenICamRuntime
    Must run before any eBUS call that needs a node map.
    The delay-loaded GenICam DLLs are NOT on PATH, and a
    miss raises SEH 0xC06D007E, which catch(...) cannot
    see: the process dies with an empty log.
  end note
}

