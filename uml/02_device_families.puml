  }

  class ModbusTcpServerCfg <<Q_GADGET>> {
    +plcType() : ModbusTcpServer
    +listenAddress / port
  }

  class ModbusTcpClientDevice <<QObject>> {
    +plcType() : ModbusTcpClient
    +writeDigitalIoByName(tag, value) : bool
    +writeWordIoByName(tag, value) : bool
