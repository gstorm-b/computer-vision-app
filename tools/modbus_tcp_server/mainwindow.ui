             <widget class="QComboBox" name="monitorTypeCombo"/>
            </item>
            <item row="1" column="4">
             <widget class="QComboBox" name="monitorOrderCombo">
              <property name="toolTip">
               <string>How a multi register value is laid out. CDAB (word swapped) is what most PLCs use for 32 bit values.</string>
              </property>
             </widget>
            </item>
            <item row="1" column="5">
             <widget class="QSpinBox" name="monitorLengthSpin">
              <property name="toolTip">
               <string>Only used by ASCII text: 2 characters per register.</string>
              </property>
              <property name="minimum">
               <number>1</number>
              </property>
              <property name="maximum">
               <number>64</number>
              </property>
