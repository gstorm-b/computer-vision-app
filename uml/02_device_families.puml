  abstract class ModbusConfig <<Q_GADGET>> {
    +unitId : int
    +coilStart / coilCount : int
    +discreteStart / discreteCount : int
    +holdingStart / holdingCount : int
    +inputStart / inputCount : int
    +resultStartAddress : int
    +range(area) : ModbusRange
