  }

  class ModbusTcpServerDevice <<QObject>> {
    +plcType() : ModbusTcpServer
    +writeDigitalIoByName(tag, value) : bool
    +writeWordIoByName(tag, value) : bool
    +sendVisionResult(positions) : bool
    -onDataWritten(table, address, size) : void
    -servedRange(area) : ModbusRange
  }
  note bottom of ModbusTcpServerDevice
    servedRange() is the UNION of the mapped span and the
    result block, because the server must own every
    register a master may touch. isConfigured() covers only
    the MAPPED span, so a write into the gap is ACKed on
    the wire and then dropped. onDataWritten() reports
    "delivered=N of M" at USER level for exactly that.
  end note

  class ModbusRegisterMap {
    +isConfigured(area, address) : bool
    +setWord(area, address, value) : bool
    +takeChangedValues() : QMap<QString, QVariant>
    +adoptCurrentAsBaseline() : void
  }

  class ModbusResultLayout <<static>> {
    +encodePayload(positions, max, truncated) : QList<quint16>
    +encodeHeader(count, sequence, flags) : QList<quint16>
    +decodeAxis(highWord, lowWord) : double
  }
  note right of ModbusResultLayout
    Scaled int32, HIGH word first, kScale = 100.
    Frozen once a master reads it. Mitsubishi MC packs
    32-bit values LOW word first, so the two families in
    this codebase disagree and only MC can express it.
  end note
}

package "VisionOutput" {
  enum VisionOutputType {
    VisionOutputTypeNone
    VisionTCPIP
    VisionTcpipClient
    VisionSerial
    VirtualVisionOutput
  }

  abstract class VisionOutputDeviceCfg {
    +visionOutputType() : VisionOutputType
    +toJson() : QJsonObject
    +fromJson(obj) : bool
  }

  abstract class VisionOutputDevice <<QObject>> {
    +visionOutputType() : VisionOutputType
    +toJson() : QJsonObject
  }

  abstract class VisionTcpipDeviceBase <<QObject>> {
    +deviceConnect() : bool
    +deviceDisconnect() : bool
    +pushRequest(request) : bool
    +runtimeState() : VisionTcpipRuntimeState
    +diagnostics() : VisionTcpipDiagnostics
    -- shared protocol core --
    #attachMainSocket(sock) : void
    #attachHeartbeatSocket(sock) : void
    #sendDisconnectNotice() : void
    #declareLostConnection(reason) : void
    -- transport hooks (subclass) --
    #startTransport() : bool
    #stopTransport() : void
    #onLinkLost() : void
  }

  note bottom of VisionTcpipDeviceBase
    Main channel (';' framed): "{detected},{x,y,z,rx,ry,rz},...;"
      each axis fixed-width "%08.2f" (e.g. 1.0 -> "00001.00");
      6 axes per position since Phase 5 (was 4: x,y,z,r -> r is now rz).
    Heartbeat channel (software is master, '.' framed):
      probe   "connection_check."  -> reply "ack,{count}."
      planned deviceDisconnect()   -> "disconnect." (one-shot,
        flushed before teardown; NOT sent on lost-connection).
  end note

  class VisionTcpipDeviceCfg <<Q_GADGET>> {
    +visionOutputType() : VisionTCPIP
    +listenAddress : QString
    +mainPort : int
    +heartbeatPort : int
    +heartbeatIntervalMs : int
    +heartbeatTimeoutMs : int
  }

  class VisionTcpipClientDeviceCfg <<Q_GADGET>> {
    +visionOutputType() : VisionTcpipClient
    +serverAddress : QString
    +mainPort : int
    +heartbeatPort : int
    +heartbeatIntervalMs : int
    +heartbeatTimeoutMs : int
    +reconnectIntervalMs : int
  }

  class VisionTcpipDevice <<QObject>> {
    +visionOutputType() : VisionTCPIP
    -- transport: QTcpServer listen + accept --
    #startTransport() : bool
    #stopTransport() : void
  }

  class VisionTcpipClientDevice <<QObject>> {
    +visionOutputType() : VisionTcpipClient
    -- transport: QTcpSocket dial-out + reconnect --
    #startTransport() : bool
    #stopTransport() : void
    #onLinkLost() : void
  }

  class VisionTcpipRuntimeState <<Q_GADGET>> {
    +mainClientConnected : bool
    +heartbeatClientConnected : bool
